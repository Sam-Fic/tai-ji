{
  "name": "scheduler-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "displayName": "Scheduler Manager",
  "description": "Session-scoped scheduled-task manager: header-action entry + modal list + /schedule write path (plugin-header-action-modal-points first consumer)",
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.9"
  },
  "taijiPlugin": {
    "manifestVersion": 1,
    "main": "index.js",
    "activationEvents": [
      "onStartupFinished"
    ],
    "trustLevel": "trusted",
    "source": "built-in",
    "permissions": [
      "sessions.readState"
    ],
    "contributes": {
      "views": [
        {
          "id": "scheduler-manager.panel",
          "view": "modal-scheduler-manager-scheduler-manager.panel",
          "placement": "host.embed",
          "title": "定时任务",
          "icon": "clock"
        }
      ]
    }
  }
}
